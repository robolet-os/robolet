Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Offset: {X: 5, Y: 4, Z: 0}
      Color: 160; 160; 164
    - Class: rviz_default_plugins/Map
      Name: Map (/map)
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 0.8
      Color Scheme: map
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar (/scan_cloud)
      Enabled: true
      Topic:
        Value: /scan_cloud
        Reliability Policy: Reliable
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 239; 41; 41
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Plan (/plan)
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Depth: 5
      Color: 25; 160; 60
      Line Width: 0.03
      Line Style: Billboards
    - Class: rviz_default_plugins/Pose
      Name: Estimated pose (/amcl/robot_pose)
      Enabled: true
      Topic:
        Value: /amcl/robot_pose
        Reliability Policy: Reliable
        Depth: 5
      Shape: Arrow
      Color: 30; 90; 230
      Shaft Length: 0.35
      Head Length: 0.15
    - Class: rviz_default_plugins/Odometry
      Name: True pose (/ground_truth)
      Enabled: true
      Topic:
        Value: /ground_truth
        Reliability Policy: Reliable
        Depth: 5
      Keep: 1
      Shape:
        Value: Arrow
        Color: 245; 130; 30
        Shaft Length: 0.3
        Head Length: 0.12
      Covariance:
        Value: false
    - Class: rviz_default_plugins/PoseArray
      Name: Candidates (/localization/candidates)
      Enabled: true
      Topic:
        Value: /localization/candidates
        Reliability Policy: Reliable
        Depth: 5
      Shape: Arrow (Flat)
      Color: 150; 60; 200
      Arrow Length: 0.3
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      X: 5
      Y: 4
      Scale: 70
      Angle: 0
Window Geometry:
  Width: 1200
  Height: 800
